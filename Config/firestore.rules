rules_version = '2';

// Regras do MathGol — permitem leitura e escrita apenas em documentos cuja
// chave (token) o cliente conheça. Sem autenticação Firebase Auth, porque
// o jogo é anônimo de propósito (crianças do fundamental, sem cadastro).
//
// ATENÇÃO: esse modelo é adequado para o MVP (sem dados sensíveis, sem
// ranking público). Para funcionalidades futuras com dados mais críticos,
// considere migrar para Firebase Auth anônimo + regras baseadas em UID.

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento do jogador (conta / progresso matemático): qualquer um pode
    // criar (é anônimo) e ler/atualizar o próprio documento se souber o
    // token (que é um UUID aleatório).
    match /jogadores/{token} {
      allow read, write: if true;

      // Subcoleção de resultados (histórico das partidas): mesma regra.
      match /resultados/{resultadoId} {
        allow read, write: if true;
      }
    }

    // Código do craque -> token. Permite a criança reencontrar a própria
    // conta em outro computador do laboratório digitando um código curto.
    // Não guarda nada pessoal: só o mesmo token opaco de sempre.
    //
    // create sem update/delete de propósito: um código, uma vez sorteado,
    // não pode ser reapontado para outro token por quem adivinhar o nome do
    // documento. Ainda assim a leitura é aberta, então quem testar códigos
    // em massa acha contas de terceiros — aceitável enquanto não há dado
    // pessoal nem ranking, mas é exatamente o que o card R03 tem que
    // reavaliar antes de rodar com turma de verdade.
    match /codigos/{codigo} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // HU-14 — Sala do Professor. Mesmo modelo do código do craque: quem
    // sabe o código entra. O professor dita o código para a turma.
    //
    // RESSALVA IMPORTANTE (card R03): "dono" guarda o token do professor,
    // mas NÃO é autenticação — qualquer cliente que saiba o código pode
    // mudar o nível da sala, e a subcoleção de alunos é legível por
    // qualquer um que tenha o código. Para uma turma real isso precisa de
    // Firebase Auth anônimo + checagem de "dono" nas regras. Enquanto o
    // conteúdo é apelido + placar (sem nome real, sem e-mail), o risco é
    // baixo e está consciente.
    match /salas/{codigo} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      match /alunos/{token} {
        allow read, write: if true;
      }
    }

    // Coleção própria só com apelido + avatar escolhidos na tela de
    // personalizar (separada de "jogadores" de propósito, ver
    // public/firebase-config.js → salvarPerfil()).
    match /apelidos/{token} {
      allow read, write: if true;
    }

    // Coleções de configuração (uma por lista, pra não misturar tudo numa
    // coleção só): personagens/animais viram os "nomes engraçados" do
    // apelido sorteado; selecoes/dificuldades são as opções das telas de
    // time e nível. O jogo só LÊ essas coleções — quem escreve é o script
    // scripts/seed-firestore.js, usando o Admin SDK (que não passa pelas
    // regras abaixo), então não precisa liberar escrita pro cliente.
    match /personagens/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /animais/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /selecoes/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    match /dificuldades/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Nega tudo mais por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
