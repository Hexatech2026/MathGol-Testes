{
  "name": "mathgol",
  "version": "1.4.0",
  "private": true,
  "description": "MathGol — jogo de pênaltis com matemática para crianças do fundamental. Site estático + Firebase (Auth anônimo + Firestore direto do navegador).",
  "scripts": {
    "start": "npx --yes serve . -l 5500",
    "dev": "npx --yes serve . -l 5500",
    "seed": "node JS/seed-firestore.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mathgol \"node --test tests/rules/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "firebase": "^12.3.0",
    "firebase-tools": "^14.0.0",
    "three": "0.149.0"
  }
}
